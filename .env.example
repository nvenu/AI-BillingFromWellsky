# ===========================================================================
# Copy to .env and fill in real values. .env is gitignored.
# ===========================================================================

# --- Kinnser (WellSky) credentials ---
KINNSER_USERNAME=your_kinnser_user
KINNSER_PASSWORD=your_kinnser_password

# --- Waystar / ZirMed credentials (Waystar rejected-claims step) ---
WAYSTAR_USERNAME=your_waystar_user
WAYSTAR_PASSWORD=your_waystar_password
# Security-question answers for the device-authentication challenge.
# Format: "keyword=answer; keyword=answer" (matched if keyword appears in the question).
WAYSTAR_SECURITY_ANSWERS="parents meet=your_answer; first job=your_answer"
# Resubmit control. Only DUPLICATE-DATE 327 claims are ever corrected.
#   WAYSTAR_SUBMIT=true       -> actually click Resubmit (irreversible). SERVER=true, LOCAL=false.
#   WAYSTAR_AUTO_CONFIRM=true -> skip the per-claim confirmation pause (needed for unattended server runs).
# Dry run (both false/unset): edits are made in the form but Resubmit is NOT clicked.
WAYSTAR_SUBMIT=false
WAYSTAR_AUTO_CONFIRM=false

# --- Email (Office 365 SMTP) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_email@solifetec.com
SMTP_PASS=your_email_password
EMAIL_RECIPIENTS=nvenu@solifetec.com

# --- Server / automation ---
PORT=8080
# Set HEADLESS=false to watch the browser while debugging automations.
HEADLESS=true
# Set DISABLE_SCHEDULER=true to stop the daily auto-run.
DISABLE_SCHEDULER=false
